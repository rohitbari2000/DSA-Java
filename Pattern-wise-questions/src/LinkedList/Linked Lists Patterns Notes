📌 5. Reverse in K-Groups
> Requires mastering reversal + pointer updates.

💡 Example: 25. Reverse Nodes in k-Group

public ListNode reverseKGroup(ListNode head, int k) {
    ListNode curr = head;
    int count = 0;

    // Check if there are at least k nodes left
    while (curr != null && count < k) {
        curr = curr.next;
        count++;
    }

    if (count == k) {
        curr = reverseKGroup(curr, k); // Recursively reverse next part

        while (count-- > 0) {
            ListNode tmp = head.next;
            head.next = curr;
            curr = head;
            head = tmp;
        }

        head = curr;
    }

    return head;
}

