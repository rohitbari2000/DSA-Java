📌 8. Palindrome Linked List
> Reverse the second half and compare.

💡 Example: 234. Palindrome Linked List

public boolean isPalindrome(ListNode head) {
    ListNode slow = head, fast = head;

    // Find mid
    while (fast != null && fast.next != null) {
        slow = slow.next;
        fast = fast.next.next;
    }

    // Reverse second half
    ListNode prev = null;
    while (slow != null) {
        ListNode next = slow.next;
        slow.next = prev;
        prev = slow;
        slow = next;
    }

    // Compare halves
    while (prev != null) {
        if (head.val != prev.val) return false;
        head = head.next;
        prev = prev.next;
    }

    return true;
}

