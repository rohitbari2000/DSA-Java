// Reverse DLL
public ListNode reverseDLL(ListNode head) {
    if(head == null || head.next == null){
        return head;
    }
    ListNode prev = null;
    while (head != null) {
        prev = head.prev;
        head.prev = head.next;
        head.next = prev;
        head = head.prev;
    }
    return prev.prev;
}

